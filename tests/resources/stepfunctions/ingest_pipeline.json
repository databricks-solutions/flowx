{
  "Comment": "Exercises JSONPath I/O: machine input and inter-task result passing",
  "StartAt": "Extract",
  "States": {
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:extract",
      "Parameters": {
        "sourceTable.$": "$.sourceTable",
        "runDate.$": "$.runDate",
        "mode": "full"
      },
      "ResultPath": "$.extract",
      "Next": "Load"
    },
    "Load": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:load",
      "Parameters": {
        "manifest.$": "$.extract.manifestPath",
        "targetTable.$": "$.targetTable"
      },
      "End": true
    }
  }
}
