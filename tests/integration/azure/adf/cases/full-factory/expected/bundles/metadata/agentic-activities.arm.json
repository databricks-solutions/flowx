{
  "name": "agentic-activities",
  "properties": {
    "activities": [
      {
        "name": "data-flow",
        "type": "ExecuteDataFlow",
        "typeProperties": {
          "compute": {
            "computeType": "General",
            "coreCount": 8
          },
          "dataFlow": {
            "referenceName": "placeholder-data-flow",
            "type": "DataFlowReference"
          }
        }
      },
      {
        "name": "until",
        "type": "Until",
        "typeProperties": {
          "activities": [
            {
              "name": "until-wait",
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 1
              }
            }
          ],
          "expression": {
            "type": "Expression",
            "value": "@equals(1,1)"
          },
          "timeout": "0.00:01:00"
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "azure-sql",
          "type": "LinkedServiceReference"
        },
        "name": "stored-procedure",
        "type": "SqlServerStoredProcedure",
        "typeProperties": {
          "storedProcedureName": "dbo.flowx_integration"
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "azure-function-parameterized",
          "type": "LinkedServiceReference"
        },
        "name": "azure-function",
        "type": "AzureFunction",
        "typeProperties": {
          "functionName": "flowx",
          "method": "GET"
        }
      },
      {
        "name": "webhook",
        "type": "WebHook",
        "typeProperties": {
          "method": "POST",
          "timeout": "00:01:00",
          "url": "https://example.invalid/webhook"
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "batch-parameterized",
          "type": "LinkedServiceReference"
        },
        "name": "custom",
        "type": "Custom",
        "typeProperties": {
          "command": "echo flowx",
          "folderPath": "integration",
          "resourceLinkedService": {
            "referenceName": "blob",
            "type": "LinkedServiceReference"
          }
        }
      },
      {
        "name": "ssis",
        "type": "ExecuteSSISPackage",
        "typeProperties": {
          "connectVia": {
            "referenceName": "azure-ssis-placeholder",
            "type": "IntegrationRuntimeReference"
          },
          "packageLocation": {
            "packagePath": "flowx/package.dtsx",
            "type": "SSISDB"
          }
        }
      },
      {
        "name": "azure-ml",
        "type": "AzureMLExecutePipeline",
        "typeProperties": {
          "mlPipelineId": "<AZURE_ML_PIPELINE_ID>",
          "version": "1"
        }
      },
      {
        "name": "get-metadata",
        "type": "GetMetadata",
        "typeProperties": {
          "dataset": {
            "referenceName": "csv-adls",
            "type": "DatasetReference"
          },
          "fieldList": [
            "exists"
          ]
        }
      },
      {
        "name": "validation",
        "type": "Validation",
        "typeProperties": {
          "dataset": {
            "referenceName": "csv-adls",
            "type": "DatasetReference"
          },
          "minimumSize": 0,
          "sleep": 1,
          "timeout": "0.00:01:00"
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "azure-sql",
          "type": "LinkedServiceReference"
        },
        "name": "script",
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": "SELECT 1",
              "type": "Query"
            }
          ]
        }
      },
      {
        "name": "fail",
        "type": "Fail",
        "typeProperties": {
          "errorCode": "FLOWX_TEST",
          "message": "intentional integration fixture"
        }
      }
    ]
  }
}