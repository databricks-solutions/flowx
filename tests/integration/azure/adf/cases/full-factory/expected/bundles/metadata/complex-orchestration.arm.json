{
  "name": "complex-orchestration",
  "properties": {
    "activities": [
      {
        "name": "launch-child",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "child-pipeline",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true
        }
      },
      {
        "dependsOn": [
          {
            "activity": "launch-child",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "linkedServiceName": {
          "referenceName": "azure-sql",
          "type": "LinkedServiceReference"
        },
        "name": "mixed-script",
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": "SELECT 1",
              "type": "Query"
            }
          ]
        }
      },
      {
        "dependsOn": [
          {
            "activity": "mixed-script",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "name": "complete",
        "type": "SetVariable",
        "typeProperties": {
          "value": "complete",
          "variableName": "state"
        }
      }
    ],
    "variables": {
      "state": {
        "defaultValue": "start",
        "type": "String"
      }
    }
  }
}