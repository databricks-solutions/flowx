{
  "name": "motif-activity-and-notify",
  "properties": {
    "activities": [
      {
        "name": "work",
        "type": "Wait",
        "typeProperties": {
          "waitTimeInSeconds": 1
        }
      },
      {
        "dependsOn": [
          {
            "activity": "work",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ],
        "name": "notify",
        "type": "WebActivity",
        "typeProperties": {
          "body": {
            "status": "complete"
          },
          "method": "POST",
          "url": "https://example.invalid/notify"
        }
      }
    ]
  }
}