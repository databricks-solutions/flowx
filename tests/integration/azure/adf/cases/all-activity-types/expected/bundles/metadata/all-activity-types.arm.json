{
  "name": "all-activity-types",
  "properties": {
    "activities": [
      {
        "inputs": [
          {
            "referenceName": "csv-adls",
            "type": "DatasetReference"
          }
        ],
        "name": "copy",
        "outputs": [
          {
            "referenceName": "parquet-adls",
            "type": "DatasetReference"
          }
        ],
        "type": "Copy",
        "typeProperties": {
          "sink": {
            "type": "ParquetSink"
          },
          "source": {
            "type": "DelimitedTextSource"
          }
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "databricks-parameterized",
          "type": "LinkedServiceReference"
        },
        "name": "notebook",
        "type": "DatabricksNotebook",
        "typeProperties": {
          "notebookPath": "/Shared/flowx/integration"
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "databricks-parameterized",
          "type": "LinkedServiceReference"
        },
        "name": "spark-jar",
        "type": "DatabricksSparkJar",
        "typeProperties": {
          "mainClassName": "com.example.Integration",
          "parameters": []
        }
      },
      {
        "linkedServiceName": {
          "referenceName": "databricks-parameterized",
          "type": "LinkedServiceReference"
        },
        "name": "spark-python",
        "type": "DatabricksSparkPython",
        "typeProperties": {
          "parameters": [],
          "pythonFile": "dbfs:/flowx/integration.py"
        }
      },
      {
        "name": "databricks-job",
        "type": "DatabricksJob",
        "typeProperties": {
          "jobId": "1",
          "jobParameters": {}
        }
      },
      {
        "name": "lookup",
        "type": "Lookup",
        "typeProperties": {
          "dataset": {
            "referenceName": "azure-sql-table",
            "type": "DatasetReference"
          },
          "firstRowOnly": true,
          "source": {
            "sqlReaderQuery": "SELECT 1 AS value",
            "type": "AzureSqlSource"
          }
        }
      },
      {
        "name": "web",
        "type": "WebActivity",
        "typeProperties": {
          "method": "GET",
          "url": "https://example.invalid/flowx"
        }
      },
      {
        "name": "delete",
        "type": "Delete",
        "typeProperties": {
          "dataset": {
            "referenceName": "json-adls",
            "type": "DatasetReference"
          },
          "enableLogging": false
        }
      },
      {
        "name": "execute-child",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "child-pipeline",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true
        }
      },
      {
        "name": "wait",
        "type": "Wait",
        "typeProperties": {
          "waitTimeInSeconds": 1
        }
      },
      {
        "name": "set-variable",
        "type": "SetVariable",
        "typeProperties": {
          "value": "running",
          "variableName": "status"
        }
      },
      {
        "name": "append-variable",
        "type": "AppendVariable",
        "typeProperties": {
          "value": "ok",
          "variableName": "results"
        }
      },
      {
        "name": "filter",
        "type": "Filter",
        "typeProperties": {
          "condition": {
            "type": "Expression",
            "value": "@not(empty(item()))"
          },
          "items": {
            "type": "Expression",
            "value": "@pipeline().parameters.items"
          }
        }
      },
      {
        "name": "foreach",
        "type": "ForEach",
        "typeProperties": {
          "activities": [
            {
              "name": "foreach-wait",
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 1
              }
            }
          ],
          "items": {
            "type": "Expression",
            "value": "@pipeline().parameters.items"
          }
        }
      },
      {
        "name": "if-condition",
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "type": "Expression",
            "value": "@equals(1,1)"
          },
          "ifFalseActivities": [
            {
              "name": "false-wait",
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 1
              }
            }
          ],
          "ifTrueActivities": [
            {
              "name": "true-wait",
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 1
              }
            }
          ]
        }
      },
      {
        "name": "switch",
        "type": "Switch",
        "typeProperties": {
          "cases": [
            {
              "activities": [
                {
                  "name": "case-wait",
                  "type": "Wait",
                  "typeProperties": {
                    "waitTimeInSeconds": 1
                  }
                }
              ],
              "value": "running"
            }
          ],
          "defaultActivities": [
            {
              "name": "default-wait",
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 1
              }
            }
          ],
          "on": {
            "type": "Expression",
            "value": "@variables('status')"
          }
        }
      }
    ],
    "parameters": {
      "items": {
        "defaultValue": [
          "one"
        ],
        "type": "Array"
      }
    },
    "variables": {
      "results": {
        "type": "Array"
      },
      "status": {
        "defaultValue": "new",
        "type": "String"
      }
    }
  }
}