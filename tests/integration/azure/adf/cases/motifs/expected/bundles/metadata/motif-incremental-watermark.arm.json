{
  "name": "motif-incremental-watermark",
  "properties": {
    "activities": [
      {
        "name": "old-watermark",
        "type": "Lookup",
        "typeProperties": {
          "dataset": {
            "referenceName": "azure-sql-table",
            "type": "DatasetReference"
          },
          "firstRowOnly": true,
          "source": {
            "sqlReaderQuery": "SELECT watermark FROM dbo.control",
            "type": "AzureSqlSource"
          }
        }
      },
      {
        "name": "new-watermark",
        "type": "Lookup",
        "typeProperties": {
          "dataset": {
            "referenceName": "azure-sql-table",
            "type": "DatasetReference"
          },
          "firstRowOnly": true,
          "source": {
            "sqlReaderQuery": "SELECT MAX(updated_at) AS watermark FROM dbo.source",
            "type": "AzureSqlSource"
          }
        }
      },
      {
        "dependsOn": [
          {
            "activity": "old-watermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "new-watermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "inputs": [
          {
            "referenceName": "azure-sql-table",
            "type": "DatasetReference"
          }
        ],
        "name": "incremental-copy",
        "outputs": [
          {
            "referenceName": "csv-adls",
            "type": "DatasetReference"
          }
        ],
        "type": "Copy",
        "typeProperties": {
          "sink": {
            "type": "DelimitedTextSink"
          },
          "source": {
            "type": "AzureSqlSource"
          }
        }
      },
      {
        "dependsOn": [
          {
            "activity": "incremental-copy",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "linkedServiceName": {
          "referenceName": "azure-sql",
          "type": "LinkedServiceReference"
        },
        "name": "update-watermark",
        "type": "SqlServerStoredProcedure",
        "typeProperties": {
          "storedProcedureName": "dbo.update_watermark"
        }
      }
    ]
  }
}