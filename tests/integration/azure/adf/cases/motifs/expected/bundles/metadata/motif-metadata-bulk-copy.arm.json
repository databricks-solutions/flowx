{
  "name": "motif-metadata-bulk-copy",
  "properties": {
    "activities": [
      {
        "name": "lookup-metadata",
        "type": "Lookup",
        "typeProperties": {
          "dataset": {
            "referenceName": "azure-sql-table",
            "type": "DatasetReference"
          },
          "firstRowOnly": false,
          "source": {
            "sqlReaderQuery": "SELECT schema_name, table_name FROM dbo.copy_config",
            "type": "AzureSqlSource"
          }
        }
      },
      {
        "dependsOn": [
          {
            "activity": "lookup-metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "name": "copy-each-table",
        "type": "ForEach",
        "typeProperties": {
          "activities": [
            {
              "inputs": [
                {
                  "referenceName": "azure-sql-table",
                  "type": "DatasetReference"
                }
              ],
              "name": "dynamic-copy",
              "outputs": [
                {
                  "referenceName": "parquet-adls",
                  "type": "DatasetReference"
                }
              ],
              "type": "Copy",
              "typeProperties": {
                "sink": {
                  "type": "ParquetSink"
                },
                "source": {
                  "type": "AzureSqlSource"
                }
              }
            }
          ],
          "items": {
            "type": "Expression",
            "value": "@activity('lookup-metadata').output.value"
          }
        }
      }
    ]
  }
}